+#ifndef MOUSE_REMOTE
+/* Latch before mouseTurnleft/right replaces LastSearchAction with this turn. */
+static u8 v6UseSlowSearchTurn(void)
+{
+    return (GucMouseTask==MAZESEARCH && spurt_search_active!=1 &&
+            V6_TURN_CHAIN==1 &&
+            (LastSearchAction==TurnLeft || LastSearchAction==TurnRight));
+}
+
+/* Same TURN controller, geometry and final phases as the original search turn.
+ * Only the precomputed wheel/angle profile and its execution time differ. */
+static void v6SlowSearchTurn90(u8 direction)
+{
+    u16 end_tick;
+    eh=0;e=0;esum=0;tick=0;
+    if(direction==TurnLeft)
+    {
+        setangle(-90);
+        turn_gyro=v6_left_gyro;turn_vl=v6_left_inner;turn_vr=v6_left_outer;
+        end_tick=V6_LEFT_TURN_TICKS;
+    }
+    else
+    {
+        setangle(90);
+        turn_gyro=v6_right_gyro;turn_vl=v6_right_outer;turn_vr=v6_right_inner;
+        end_tick=V6_RIGHT_TURN_TICKS;
+    }
+    task=TURN;
+    while(tick<end_tick);
+    settrack(0);
+}
+#endif
+
