+#ifndef MOUSE_REMOTE
+/* Depart at search-turn speed before committing the next grid coordinate.
+ * Keep the inherited 180-turn geometry (front wall: 90 - 35 = 55 mm).
+ * taskacc includes its 40 mm ramp in this total; do not count it twice.
+ * No extra wall-alignment turns and no ordinary 90-turn compensation. */
+static void goalDepartureAfterTurnback(void)
+{
+    long distance=(long)disbf180-35;
+    if(distance<(long)accdistance) distance=accdistance;
+    distance+=GOAL_DEPARTURE_EXTRA_MM;
+    taskacc();
+    task=SMARTSTRAIGHT;
+    while(track<distance);
+    afterturn_flag=0;
+}
+#endif
